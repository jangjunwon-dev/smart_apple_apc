<?xml version="1.0" ?>
<!-- 단독 확인용 (반지름 0.04 m). 스포너는 apple_factory.apple_sdf(..., apple_model='ycb') 사용 -->
<sdf version="1.9">
  <model name="ycb_apple">
    <link name="link">
      <inertial>
        <mass>0.22786</mass>
        <inertia>
          <ixx>0.00014583</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00014583</iyy><iyz>0</iyz><izz>0.00014583</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 -0.00800 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.04000</radius><length>0.06400</length></cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://ycb_apple/meshes/ycb_apple.glb</uri>
            <scale>0.04 0.04 0.04</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
