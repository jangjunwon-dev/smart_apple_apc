<?xml version="1.0" ?>
<!--
  Smart APC 미리보기 월드 v2 (팀 공유용, 팀 합의 전)
  - apc_world.sdf 의 물리·플러그인·조명·바닥·컨베이어·카메라·apple_sink·zone_A/B/C/R 을 그대로 복사
  - 추가: 건물 외벽(지붕 없음), 입고 구역, 세척·건조 덮개, 선별 터널, 저온저장고·출하 구역
  - 덮개·터널은 visual 만 (collision 없음, 그림자 없음) → 사과 흐름·카메라 영상 영향 최소화
  - 외부 모델은 src/apc_simulation/models/ (출처: models/ATTRIBUTION.md)
  - world name 은 apc_world 그대로 → sim.launch.py 브리지·사과 스포너 재사용
  실행: ros2 launch apc_simulation sim.launch.py world:=apc_world_v2_preview.sdf
-->
<sdf version="1.9">
  <world name="apc_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- 논리 카메라: 시야 안 모델 이름·위치 발행 (사과 삭제 판정용) -->
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 컨베이어: 길이 3.0m (x -3.5 ~ -0.5), 폭 0.5m, 윗면 z=0.8
         공식 예제(gz-sim worlds/conveyor.sdf)처럼 정적 링크 + TrackController 로 표면 속도 부여 -->
    <model name="conveyor">
      <static>true</static>
      <pose>-2 0 0.4 0 0 0</pose>
      <link name="belt">
        <collision name="collision">
          <geometry><box><size>3.0 0.5 0.8</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.5 0.8</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <!-- 가이드 레일: 벨트와 다른 링크여야 TrackController 영향을 받지 않음 -->
      <link name="guides">
        <collision name="left_collision">
          <pose>0 0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
        </collision>
        <visual name="left_visual">
          <pose>0 0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
        <collision name="right_collision">
          <pose>0 -0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
        </collision>
        <visual name="right_visual">
          <pose>0 -0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-track-controller-system"
              name="gz::sim::systems::TrackController">
        <link>belt</link>
        <odometry_publish_frequency>1</odometry_publish_frequency>
      </plugin>
    </model>

    <!-- 선별 카메라: 컨베이어 위에서 아래를 봄 -->
    <model name="grading_camera">
      <static>true</static>
      <pose>-2 0 1.6 0 1.5707 0</pose>
      <link name="camera_link">
        <visual name="visual"><geometry><box><size>0.08 0.08 0.08</size></box></geometry></visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>apc/camera/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- 사과 수거 지점: 컨베이어 끝(x=-0.5)에서 떨어지는 사과를 감지하는 논리 카메라
         z=0.9 에서 아래를 봄. 벨트 윗면(z=0.8) 높이에서는 시야가 x≈-0.32~-0.18 로 좁아
         벨트 위 사과는 잡히지 않고, 바닥(z=0)에서는 x≈-0.86~0.36 을 덮음 -->
    <model name="apple_sink">
      <static>true</static>
      <pose>-0.25 0 0.9 0 1.5707 0</pose>
      <link name="sink_link">
        <sensor name="apple_sink_camera" type="logical_camera">
          <update_rate>10</update_rate>
          <logical_camera>
            <near>0.05</near>
            <far>1.0</far>
            <horizontal_fov>1.2</horizontal_fov>
            <aspect_ratio>1.0</aspect_ratio>
          </logical_camera>
          <always_on>1</always_on>
          <topic>apc/sim/apple_sink</topic>
        </sensor>
      </link>
    </model>

    <!-- 등급별 적재 구역 (바닥 표시) -->
    <model name="zone_A"><static>true</static><pose>4 2 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="zone_B"><static>true</static><pose>4 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual></link></model>
    <model name="zone_C"><static>true</static><pose>4 -2 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link></model>
    <model name="zone_R"><static>true</static><pose>0 -3 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material></visual></link></model>

    <!-- ===================== 미리보기 장식 (v2 preview) ===================== -->
    <!-- 건물 외벽: 중심 (1.0, -0.5), 20 x 12 m → x -9~11, y -6.5~5.5, 높이 3 m, 지붕 없음 -->
    <!-- 서쪽 출입구(입고) y -1.5~1.5 / 동쪽 출입구(출하) y -2.25~1.25 -->
    <model name="wall_north"><static>true</static><pose>1.0 5.5 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>20.2 0.2 3.0</size></box></geometry></collision><visual name="v"><geometry><box><size>20.2 0.2 3.0</size></box></geometry><material><ambient>0.86 0.88 0.9 1</ambient><diffuse>0.86 0.88 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>1.0 -6.5 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>20.2 0.2 3.0</size></box></geometry></collision><visual name="v"><geometry><box><size>20.2 0.2 3.0</size></box></geometry><material><ambient>0.86 0.88 0.9 1</ambient><diffuse>0.86 0.88 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_west_s"><static>true</static><pose>-9.0 -4.0 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 5.0 3.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 5.0 3.0</size></box></geometry><material><ambient>0.86 0.88 0.9 1</ambient><diffuse>0.86 0.88 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_west_n"><static>true</static><pose>-9.0 3.5 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 4.0 3.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4.0 3.0</size></box></geometry><material><ambient>0.86 0.88 0.9 1</ambient><diffuse>0.86 0.88 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_east_s"><static>true</static><pose>11.0 -4.375 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 4.25 3.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4.25 3.0</size></box></geometry><material><ambient>0.86 0.88 0.9 1</ambient><diffuse>0.86 0.88 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_east_n"><static>true</static><pose>11.0 3.375 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 4.25 3.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4.25 3.0</size></box></geometry><material><ambient>0.86 0.88 0.9 1</ambient><diffuse>0.86 0.88 0.9 1</diffuse></material></visual></link></model>
    <!-- 입고 구역 (x -8~-4.5): 팔레트 + 노란 사과 상자. 서쪽 출입구 앞 통로 y -1.5~1.5 는 비움 -->
    <include><name>intake_1_pallet</name><uri>model://euro_pallet</uri><static>true</static><pose>-6.500 2.800 0.072 0 0 1.5708</pose></include>
    <include><name>intake_1_crate_000</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_001</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_010</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_011</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_100</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_101</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_110</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_111</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_200</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_201</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_210</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_211</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_pallet</name><uri>model://euro_pallet</uri><static>true</static><pose>-6.500 -2.800 0.072 0 0 1.5708</pose></include>
    <include><name>intake_2_crate_000</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_001</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_010</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_011</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_100</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_101</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_110</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_111</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_200</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_201</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_210</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_211</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_3_pallet</name><uri>model://euro_pallet</uri><static>true</static><pose>-5.000 3.800 0.072 0 0 1.5708</pose></include>
    <include><name>intake_3_crate_000</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-5.295 3.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_001</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-5.295 3.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_010</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-4.705 3.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_011</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-4.705 3.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_100</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-5.295 3.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_101</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-5.295 3.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_110</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-4.705 3.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_3_crate_111</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-4.705 3.995 0.569 0 0 0.0000</pose></include>
    <include><name>pallet_jack</name><uri>model://Pallet_Jack</uri><static>true</static><pose>-8.000 -4.500 0.000 0 0 0.0000</pose></include>
    <!-- 세척·건조 덮개: x -3.45~-2.9, visual 만(collision 없음), 그림자 없음 → 사과 흐름·카메라 밝기 영향 없음 -->
    <model name="wash_dry_cover"><static>true</static><pose>-3.175 0 0 0 0 0</pose>
      <link name="l">
        <visual name="roof"><pose>0 0 1.35 0 0 0</pose><cast_shadows>false</cast_shadows><transparency>0.6</transparency><geometry><box><size>0.55 0.9 0.02</size></box></geometry><material><ambient>0.2 0.5 0.9 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material></visual>
        <visual name="side_l"><pose>0 0.45 1.1 0 0 0</pose><cast_shadows>false</cast_shadows><transparency>0.6</transparency><geometry><box><size>0.55 0.02 0.5</size></box></geometry><material><ambient>0.2 0.5 0.9 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material></visual>
        <visual name="side_r"><pose>0 -0.45 1.1 0 0 0</pose><cast_shadows>false</cast_shadows><transparency>0.6</transparency><geometry><box><size>0.55 0.02 0.5</size></box></geometry><material><ambient>0.2 0.5 0.9 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material></visual>
        <visual name="nozzle_1"><pose>-0.15 0 1.25 1.5708 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.015</radius><length>0.86</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
        <visual name="nozzle_2"><pose>0.12 0 1.25 1.5708 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.015</radius><length>0.86</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link></model>
    <!-- 카메라 선별 터널: x -2.85~-1.15, visual 만, 그림자 없음.
         카메라(z=1.6) 시야: 벨트면 y±0.46 x±0.35 / 바닥 y±0.92 x -2.69~-1.31
         → 지붕 z 1.75 이상, 옆판 |y|=0.55 · z≥0.85, 기둥 x -2.85/-1.15 (시야 밖) -->
    <model name="grading_tunnel"><static>true</static><pose>-2.0 0 0 0 0 0</pose>
      <link name="l">
        <visual name="roof"><pose>0 0 1.775 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.7 1.14 0.05</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <visual name="side_l"><pose>0 0.55 1.3 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.7 0.02 0.9</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <visual name="side_r"><pose>0 -0.55 1.3 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.7 0.02 0.9</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <visual name="lamp"><pose>0 0 1.745 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.2 0.06 0.01</size></box></geometry><material><ambient>1 1 0.95 1</ambient><diffuse>1 1 0.95 1</diffuse><emissive>1 1 0.95 1</emissive></material></visual>
        <visual name="post_0"><pose>-0.85 0.55 0.875 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.04 0.04 1.75</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <visual name="post_1"><pose>-0.85 -0.55 0.875 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.04 0.04 1.75</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <visual name="post_2"><pose>0.85 0.55 0.875 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.04 0.04 1.75</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
