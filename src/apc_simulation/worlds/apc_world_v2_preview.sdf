<?xml version="1.0" ?>
<!--
  Smart APC 미리보기 월드 v2 (팀 공유용, 팀 합의 전) — scripts/gen_preview_world.py 로 생성
  - apc_world.sdf 의 물리·플러그인·조명·바닥·컨베이어·카메라·apple_sink·zone_A/B/C/R 을 그대로 복사
  - 추가: 초록 에폭시 바닥(카메라 아래 x -3~-1, y ±1.2 는 기존 바닥색 + 노란 안전선),
    흰 샌드위치 패널 외벽(5 m), 철골 트러스(지붕판 없음), 입고 구역, 세척·건조 덮개, 선별 터널,
    선별 라인 부속(다리·롤러·가이드·등급별 배출 슈트·제어반), 단열 패널 저온저장고, 출하 구역
  - 장식은 그림자 없음, 조명 추가 없음. 선별 라인 부속은 visual 만(다리·제어반만 바닥~0.5 m collision)
  - 외부 모델·텍스처는 src/apc_simulation/models/ (출처: models/ATTRIBUTION.md)
  - world name 은 apc_world 그대로 → sim.launch.py 브리지·사과 스포너 재사용
  실행: ros2 launch apc_simulation sim.launch.py world:=apc_world_v2_preview.sdf
-->
<sdf version="1.9">
  <world name="apc_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- 논리 카메라: 시야 안 모델 이름·위치 발행 (사과 삭제 판정용) -->
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 컨베이어: 길이 3.0m (x -3.5 ~ -0.5), 폭 0.5m, 윗면 z=0.8
         공식 예제(gz-sim worlds/conveyor.sdf)처럼 정적 링크 + TrackController 로 표면 속도 부여 -->
    <model name="conveyor">
      <static>true</static>
      <pose>-2 0 0.4 0 0 0</pose>
      <link name="belt">
        <collision name="collision">
          <geometry><box><size>3.0 0.5 0.8</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.5 0.8</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <!-- 가이드 레일: 벨트와 다른 링크여야 TrackController 영향을 받지 않음 -->
      <link name="guides">
        <collision name="left_collision">
          <pose>0 0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
        </collision>
        <visual name="left_visual">
          <pose>0 0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
        <collision name="right_collision">
          <pose>0 -0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
        </collision>
        <visual name="right_visual">
          <pose>0 -0.26 0.43 0 0 0</pose>
          <geometry><box><size>3.0 0.02 0.06</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-track-controller-system"
              name="gz::sim::systems::TrackController">
        <link>belt</link>
        <odometry_publish_frequency>1</odometry_publish_frequency>
      </plugin>
    </model>

    <!-- 선별 카메라: 컨베이어 위에서 아래를 봄 -->
    <model name="grading_camera">
      <static>true</static>
      <pose>-2 0 1.6 0 1.5707 0</pose>
      <link name="camera_link">
        <visual name="visual"><geometry><box><size>0.08 0.08 0.08</size></box></geometry></visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>apc/camera/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- 사과 수거 지점: 컨베이어 끝(x=-0.5)에서 떨어지는 사과를 감지하는 논리 카메라
         z=0.9 에서 아래를 봄. 벨트 윗면(z=0.8) 높이에서는 시야가 x≈-0.32~-0.18 로 좁아
         벨트 위 사과는 잡히지 않고, 바닥(z=0)에서는 x≈-0.86~0.36 을 덮음 -->
    <model name="apple_sink">
      <static>true</static>
      <pose>-0.25 0 0.9 0 1.5707 0</pose>
      <link name="sink_link">
        <sensor name="apple_sink_camera" type="logical_camera">
          <update_rate>10</update_rate>
          <logical_camera>
            <near>0.05</near>
            <far>1.0</far>
            <horizontal_fov>1.2</horizontal_fov>
            <aspect_ratio>1.0</aspect_ratio>
          </logical_camera>
          <always_on>1</always_on>
          <topic>apc/sim/apple_sink</topic>
        </sensor>
      </link>
    </model>

    <!-- 등급별 적재 구역 (바닥 표시) -->
    <model name="zone_A"><static>true</static><pose>4 2 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="zone_B"><static>true</static><pose>4 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual></link></model>
    <model name="zone_C"><static>true</static><pose>4 -2 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link></model>
    <model name="zone_R"><static>true</static><pose>0 -3 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry>
        <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material></visual></link></model>

    <!-- ===================== 미리보기 장식 (v2 preview) ===================== -->
    <!-- 초록 에폭시 바닥(visual 만, 윗면 z 0.004). 카메라 아래 x -3.0~-1.0, y -1.2~1.2 는 비워 기존 바닥색 유지 + 둘레 노란 안전선 -->
    <model name="epoxy_floor"><static>true</static><pose>0 0 0 0 0 0</pose>
      <link name="l">
        <visual name="epoxy"><cast_shadows>false</cast_shadows><geometry><mesh><uri>model://apc_preview_assets/meshes/epoxy_floor.obj</uri></mesh></geometry><material><ambient>0.3 0.7 0.42 1</ambient><diffuse>0.3 0.7 0.42 1</diffuse><specular>0.2 0.2 0.2 1</specular><pbr><metal><albedo_map>model://apc_preview_assets/materials/textures/Concrete034_1K-JPG_Color.jpg</albedo_map><normal_map>model://apc_preview_assets/materials/textures/Concrete034_1K-JPG_NormalGL.jpg</normal_map><roughness_map>model://apc_preview_assets/materials/textures/Concrete034_1K-JPG_Roughness.jpg</roughness_map><roughness>0.45</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
        <visual name="safety_north"><pose>-2.0000 1.2500 0.0050 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>2.2 0.1 0.002</size></box></geometry><material><ambient>0.95 0.78 0.05 1</ambient><diffuse>0.95 0.78 0.05 1</diffuse></material></visual>
        <visual name="safety_south"><pose>-2.0000 -1.2500 0.0050 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>2.2 0.1 0.002</size></box></geometry><material><ambient>0.95 0.78 0.05 1</ambient><diffuse>0.95 0.78 0.05 1</diffuse></material></visual>
        <visual name="safety_west"><pose>-3.0500 0.0000 0.0050 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.1 2.4 0.002</size></box></geometry><material><ambient>0.95 0.78 0.05 1</ambient><diffuse>0.95 0.78 0.05 1</diffuse></material></visual>
        <visual name="safety_east"><pose>-0.9500 0.0000 0.0050 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.1 2.4 0.002</size></box></geometry><material><ambient>0.95 0.78 0.05 1</ambient><diffuse>0.95 0.78 0.05 1</diffuse></material></visual>
      </link></model>
    <!-- 건물 외벽(흰 샌드위치 패널): x -9~11, y -6.5~5.5, 높이 5 m, 지붕판 없음.
         서쪽 출입구(입고) y -1.5~1.5 / 동쪽 출입구(출하) y -2.25~1.25, 출입구 위 z 3.5~5 상인방 + 셔터 박스 -->
    <model name="building_walls"><static>true</static><pose>0 0 0 0 0 0</pose>
      <link name="l">
        <collision name="wall_north"><pose>1.0000 5.5000 2.5000 0.0000 0.0000 0.0000</pose><geometry><box><size>20.2 0.2 5</size></box></geometry></collision>
        <collision name="wall_south"><pose>1.0000 -6.5000 2.5000 0.0000 0.0000 0.0000</pose><geometry><box><size>20.2 0.2 5</size></box></geometry></collision>
        <collision name="wall_west_s"><pose>-9.0000 -4.0000 2.5000 0.0000 0.0000 0.0000</pose><geometry><box><size>0.2 5 5</size></box></geometry></collision>
        <collision name="wall_west_n"><pose>-9.0000 3.5000 2.5000 0.0000 0.0000 0.0000</pose><geometry><box><size>0.2 4 5</size></box></geometry></collision>
        <collision name="wall_east_s"><pose>11.0000 -4.3750 2.5000 0.0000 0.0000 0.0000</pose><geometry><box><size>0.2 4.25 5</size></box></geometry></collision>
        <collision name="wall_east_n"><pose>11.0000 3.3750 2.5000 0.0000 0.0000 0.0000</pose><geometry><box><size>0.2 4.25 5</size></box></geometry></collision>
        <visual name="panels"><cast_shadows>false</cast_shadows><geometry><mesh><uri>model://apc_preview_assets/meshes/sandwich_walls.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.2 0.2 0.2 1</specular><pbr><metal><albedo_map>model://apc_preview_assets/materials/textures/CorrugatedSteel007A_1K-JPG_Color_white.jpg</albedo_map><normal_map>model://apc_preview_assets/materials/textures/CorrugatedSteel007A_1K-JPG_NormalGL.jpg</normal_map><roughness_map>model://apc_preview_assets/materials/textures/CorrugatedSteel007A_1K-JPG_Roughness.jpg</roughness_map><roughness>0.8</roughness><metalness>0.2</metalness></metal></pbr></material></visual>
        <visual name="shutter_box_0"><pose>-8.7500 0.0000 3.7000 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.3 3.2 0.4</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_slat_0"><pose>-8.8500 0.0000 3.3500 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.03 3 0.3</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_rail_00"><pose>-8.8700 -1.5500 1.7500 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.06 0.1 3.5</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_rail_01"><pose>-8.8700 1.5500 1.7500 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.06 0.1 3.5</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_box_1"><pose>10.7500 -0.5000 3.7000 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.3 3.7 0.4</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_slat_1"><pose>10.8500 -0.5000 3.3500 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.03 3.5 0.3</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_rail_10"><pose>10.8700 -2.3000 1.7500 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.06 0.1 3.5</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
        <visual name="shutter_rail_11"><pose>10.8700 1.3000 1.7500 0.0000 0.0000 0.0000</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.06 0.1 3.5</size></box></geometry><material><ambient>0.7 0.72 0.74 1</ambient><diffuse>0.7 0.72 0.74 1</diffuse></material></visual>
      </link></model>
    <!-- 철골 (visual 만, 그림자 없음, 지붕판 없음): 트러스 6개 x (-8.85, -5.0, -1.0, 3.0, 7.0, 10.85), 하현재 z 5.05, 용마루 y -0.5 z 6.2,
         중도리 1.5 m 간격, H형 기둥(벽 안쪽 y 5.3 / -6.3) -->
    <model name="steel_frame"><static>true</static><pose>0 0 0 0 0 0</pose>
      <link name="l">
        <visual name="frame"><cast_shadows>false</cast_shadows><geometry><mesh><uri>model://apc_preview_assets/meshes/steel_frame.obj</uri></mesh></geometry><material><ambient>0.52 0.57 0.63 1</ambient><diffuse>0.52 0.57 0.63 1</diffuse></material></visual>
      </link></model>
    <!-- 입고 구역 (x -8~-4.5): 팔레트 + 노란 사과 상자. 서쪽 출입구 앞 통로 y -1.5~1.5 는 비움 -->
    <include><name>intake_1_pallet</name><uri>model://euro_pallet</uri><static>true</static><pose>-6.500 2.800 0.072 0 0 1.5708</pose></include>
    <include><name>intake_1_crate_000</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_001</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_010</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_011</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_100</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_101</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_110</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_111</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_200</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_201</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_210</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_1_crate_211</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_pallet</name><uri>model://euro_pallet</uri><static>true</static><pose>-6.500 -2.800 0.072 0 0 1.5708</pose></include>
    <include><name>intake_2_crate_000</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_001</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_010</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.995 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_011</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.605 0.284 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_100</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_101</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_110</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.995 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_111</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.605 0.569 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_200</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_201</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.795 -2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_210</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.995 0.854 0 0 0.0000</pose></include>
    <include><name>intake_2_crate_211</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-6.205 -2.605 0.854 0 0 0.0000</pose></include>
    <include><name>intake_3_pallet</name><uri>model://euro_pallet</uri><static>true</static><pose>-5.000 3.800 0.072 0 0 1.5708</pose></include>
    <include><name>intake_3_crate_000</name><uri>model://apc_apple_crate</uri><static>true</static><pose>-5.295 3.605 0.284 0 0 0.0000</pose></include>
